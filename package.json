{
  "name": "reverie-ai-wellness",
  "version": "1.0.0",
  "description": "AI-powered mental wellness companion with adaptive 3D avatars and habit tracking",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "npm install --build-from-source",
    "cap:init": "npx @capacitor/cli init Reverie com.reverie.wellness --web-dir public",
    "cap:add:ios": "npx cap add ios",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npx cap sync",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "mobile:build": "npm run cap:sync"
  },
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "uuid": "^10.0.0"
  }
}
